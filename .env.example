# LLM Web Scraper Configuration
# Copy this file to .env and update values

# ===================
# Required
# ===================

# Anthropic API key for LLM operations
ANTHROPIC_API_KEY=sk-ant-...

# ===================
# Optional (defaults shown)
# ===================

# Fetcher adapter: httpx (simple) or playwright (full browser)
FETCHER=httpx

# Storage adapter: local (filesystem) or s3 (AWS S3)
STORAGE=local

# LLM provider: direct (Anthropic/OpenAI) or pocketflow (orchestration)
LLM_PROVIDER=direct

# Alerting adapter: console (stdout) or knock (Knock.app)
ALERTING=console

# Local storage base path
DATA_PATH=data

# ===================
# S3 Storage (if STORAGE=s3)
# ===================

# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET=...
# S3_REGION=us-east-1

# ===================
# Knock Alerting (if ALERTING=knock)
# ===================

# KNOCK_API_KEY=...
# KNOCK_WORKFLOW_KEY=...
