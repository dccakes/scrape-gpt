# LLM Web Scraper v2.0 - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: LLM Provider Configuration
# ============================================================================

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OR OpenAI API Key (alternative)
# OPENAI_API_KEY=sk-...

# ============================================================================
# OPTIONAL: Adapter Selection
# ============================================================================
# Default: Simple adapters for development
# Change these to use production adapters

# Page Fetcher: httpx (simple) or playwright (full browser with JS)
FETCHER=httpx

# Storage: local (filesystem) or s3 (AWS S3)
STORAGE=local

# LLM Provider: direct (Anthropic/OpenAI) or pocketflow (orchestration)
LLM_PROVIDER=direct

# Alerting: console (stdout) or knock (Knock.app)
ALERTING=console

# ============================================================================
# AWS S3 Storage Configuration (if STORAGE=s3)
# ============================================================================

# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# S3_BUCKET=my-scraper-data

# ============================================================================
# Knock Alerting Configuration (if ALERTING=knock)
# ============================================================================

# KNOCK_API_KEY=sk_live_...
# KNOCK_WORKFLOW_KEY=scraper-alerts

# ============================================================================
# Scraper Configuration
# ============================================================================

# Base data directory for local storage
DATA_DIR=./data

# Coverage threshold for config generation (0.0-1.0)
COVERAGE_THRESHOLD=0.8

# Maximum repair iterations for config validation
MAX_REPAIR_ITERATIONS=3

# Number of sample pages for config generation
SAMPLE_COUNT=5

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=text

# ============================================================================
# Development Settings
# ============================================================================

# Enable debug mode (more verbose logging)
DEBUG=false

# Playwright browser headless mode
PLAYWRIGHT_HEADLESS=true

# HTTP request timeout (milliseconds)
REQUEST_TIMEOUT=30000
